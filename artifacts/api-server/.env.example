# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ── Supabase ──────────────────────────────────────────────────────────────
# From: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # service_role key — NEVER expose to frontend

# ── Firebase Admin ────────────────────────────────────────────────────────
# From: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire downloaded JSON as a single-line string (must include type + private_key)
# Do NOT paste the frontend/web Firebase config here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# ── Gemini AI ────────────────────────────────────────────────────────────
# From: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Optional: override local embedding model cache directory
# MODEL_CACHE_DIR=./.model-cache

# ── n8n Webhooks (optional) ───────────────────────────────────────────────
# Leave blank to disable; the app continues working without n8n
N8N_APPLICATION_WEBHOOK_URL=
N8N_INTERVIEW_WEBHOOK_URL=
